{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MongoDb": "mongodb://mongo:27017"
  },
  "RabbitMq": {
    "Infrastructure": {
      "HostName": "rabbitMq",
      "UserName": "guest",
      "Password": "guest",
      "Port": 5672
    },
    "Consumers": {
      "Default": {
        "RoutingKey": "*"
      },
      "VideoReceived": {
        "Exchange": "video",
        "Queue": "visionary_analytics_worker",
        "RoutingKey": "received"
      }
    },
    "Exchanges": {
      "Default": {
        "Type": "topic",
        "Durable": true,
        "AutoDelete": false
      },
      "video": {}
    },
    "Queues": {
      "Default": {
        "Durable": true,
        "Exclusive": false,
        "AutoDelete": false
      },
      "visionary_analytics_worker": {}
    }
  }
}
